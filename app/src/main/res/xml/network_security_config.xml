<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed at platform level (home servers on the LAN); CleartextPolicyInterceptor
     refuses cleartext towards non-private hosts unless the user explicitly opts in. User-installed
     CA certificates are trusted so self-signed reverse proxies work. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
